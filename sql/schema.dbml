// ============================================================================
// HE THONG QUAN LY MY PHAM - DATABASE DIAGRAM AS CODE (DBML)
// Nguon: database thuc te (17 service database / 31 bang)
// Cong cu: https://dbml.dbdiagram.io
//
// Cach dung:
//   - Mo https://dbdiagram.io/d -> paste noi dung file nay vao editor, hoac
//     Import -> DBML -> chon file nay
//   - Export/Docs: https://dbdocs.io (tu DBML nay tao web docs)
//
// Ky hieu Ref:
//   child.fk > parent.pk  : many-to-one (nhieu dong con tro ve 1 dong cha)
//   parent.pk - child.fk  : one-to-one (cot thu 2 la FK)
//   [delete: cascade]     : FK vat ly, co ON DELETE CASCADE trong Postgres
//
// Luu y quan trong:
//   - Day la kien truc microservice: moi service mot database rieng, nen hau het
//     quan he la LOGIC (khong co FK constraint that trong DB).
//   - Cac FK giua service thuong giu id dang varchar(255) (uuid luoi qua string),
//     vi du orders.customer_id (varchar) -> customers.id (uuid).
//   - Chi 13 quan he duoi day la FK vat ly (cung database, co cascade).
// ============================================================================

Project cosmetic_management {
  database_type: 'PostgreSQL'
  Note: '''He thong quan ly my pham - 17 microservice database (NestJS + MikroORM + PostgreSQL).'''
}

// ============================================================================
// I. NGUOI DUNG - DB: cosmetic_user_service
// ============================================================================

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  first_name varchar(255) [not null]
  last_name varchar(255) [not null]
  gender text [not null]
  email varchar(255) [not null, unique]
  role_id varchar(255) [not null, note: 'FK logic -> roles.id (phan quyen)']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  is_active boolean [not null, default: true]

  checks {
    `gender in ('male','female','other')` [name: 'users_gender_check']
  }
}

// ============================================================================
// II. AUTHENTICATION - DB: cosmetic_authentication_service
// ============================================================================

Table auth_users {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique]
  password varchar(255) [not null]
  email_verified_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

// ============================================================================
// III. PHONG BAN - DB: cosmetic_department_service
// ============================================================================

Table departments {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(255) [not null, unique]
  manager_id varchar(255)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  code varchar(255) [not null, unique]
  is_active boolean [not null, default: true]
}

// ============================================================================
// IV. NHAN VIEN - DB: cosmetic_employee_service
// ============================================================================

Table employees {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id varchar(255) [not null, unique]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  code varchar(255) [not null, unique]
  department_id varchar(255) [not null]
  hired_at timestamptz [not null]
  status text [not null, default: 'ACTIVE']
  phone varchar(255)
  address varchar(255)
  position text [not null]

  checks {
    `position in ('staff','manager')` [name: 'employees_position_check']
    `status in ('ACTIVE','INACTIVE','ON_LEAVE','TERMINATED')` [name: 'employees_status_check']
  }
}

// ============================================================================
// V. KHACH HANG - DB: cosmetic_customer_service
// ============================================================================

Table customers {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id varchar(255) [not null, unique]
  code varchar(255) [not null, unique]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table addresses {
  id uuid [pk, default: `gen_random_uuid()`]
  customer_id uuid [not null]
  city varchar(255) [not null]
  street varchar(255) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table phones {
  id uuid [pk, default: `gen_random_uuid()`]
  customer_id uuid [not null]
  phone varchar(255) [not null, unique]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

// ============================================================================
// VI. DANH MUC - DB: cosmetic_category_service
// ============================================================================

Table categories {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(255) [not null, unique]
  description varchar(255)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

// ============================================================================
// VII. NHA CUNG CAP - DB: cosmetic_supplier_service
// ============================================================================

Table suppliers {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(255) [not null, unique]
  name varchar(255) [not null]
  email varchar(255) [not null, unique]
  phone varchar(255)
  address varchar(255)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

// ============================================================================
// VIII. SAN PHAM MY PHAM - DB: cosmetic_cosmetic_service
// ============================================================================

Table cosmetics {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(255) [not null, unique]
  name varchar(255) [not null]
  brand varchar(255)
  origin varchar(255)
  description varchar(1000)
  image_url varchar(500)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table cosmetic_variants {
  id uuid [pk, default: `gen_random_uuid()`]
  cosmetic_id uuid [not null]
  name varchar(255) [not null]
  color varchar(255)
  volume varchar(255)
  price decimal(12,2) [not null]
  cost_price decimal(12,2) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  checks {
    `price >= 0` [name: 'cosmetic_variants_price_check']
    `cost_price >= 0` [name: 'cosmetic_variants_cost_price_check']
  }
}

Table cosmetic_categories {
  id uuid [pk, default: `gen_random_uuid()`]
  cosmetic_id uuid [not null]
  category_id uuid [not null]
  created_at timestamptz [not null]
}

// ============================================================================
// IX. TON KHO - DB: cosmetic_inventory_service
// ============================================================================

Table inventories {
  id uuid [pk, default: `gen_random_uuid()`]
  variant_id varchar(255) [not null, unique]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  min_stock int [not null, default: 0, note: 'nguong canh bao ton thap']
  is_active boolean [not null, default: true]
  created_by uuid [note: 'FK logic -> users.id (nguoi tao)']

  checks {
    `min_stock >= 0` [name: 'inventories_min_stock_check']
  }
}

Table batches {
  id uuid [pk, default: `gen_random_uuid()`]
  inventory_id uuid [not null]
  lot_number varchar(255) [not null, note: 'so lo hang']
  supplier_id varchar(255) [not null, note: 'FK logic -> suppliers.id']
  quantity int [not null, default: 0]
  expiry_date date [note: 'han su dung cua lo']
  is_active boolean [not null, default: true]
  created_by uuid [note: 'FK logic -> users.id']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (inventory_id, lot_number) [unique, name: 'batches_inventory_lot_number_unique']
  }
}

Table stock_adjustments {
  id uuid [pk, default: `gen_random_uuid()`]
  batch_id uuid [not null]
  variant_id varchar(255) [not null, note: 'FK logic -> cosmetic_variants.id']
  adjustment int [not null, note: 'so luong +/- (khac 0)']
  reason varchar(255) [not null]
  note varchar(255)
  created_by uuid [not null, note: 'FK logic -> users.id']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  checks {
    `reason in ('DAMAGED','DEFECTIVE','EXPIRED','OVERSTOCK','OTHER')` [name: 'stock_adjustments_reason_check']
    `adjustment <> 0` [name: 'stock_adjustments_adjustment_check']
  }
}

// ============================================================================
// X. NHAP HANG - DB: cosmetic_purchase_service
// ============================================================================

Table purchase_orders {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(255) [not null, unique]
  supplier_id varchar(255) [not null]
  status text [not null, default: 'PENDING']
  total_amount decimal(12,2) [not null, default: 0]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  employee_id varchar(255) [note: 'FK logic -> employees.id (nguoi lap phieu)']

  checks {
    `status in ('PENDING','COMPLETED','CANCELLED')` [name: 'purchase_orders_status_check']
  }
}

Table purchase_order_lines {
  id uuid [pk, default: `gen_random_uuid()`]
  purchase_order_id uuid [not null]
  variant_id varchar(255) [not null]
  quantity int [not null, default: 1]
  unit_price decimal(12,2) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  expiry_date date [note: 'han su dung nhap them (co the de trong)']
}

Table purchase_transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  purchase_order_id uuid [not null]
  variant_id varchar(255) [not null]
  quantity int [not null, default: 1]
  unit_price decimal(12,2) [not null]
  subtotal decimal(12,2) [not null, default: 0]
  employee_id varchar(255) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

// ============================================================================
// XI. BAN HANG - DB: cosmetic_order_service
// ============================================================================

Table orders {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(255) [not null, unique]
  customer_id varchar(255) [not null]
  status text [not null, default: 'pending']
  total_amount decimal(12,2) [not null, default: 0]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  payment_method varchar(255) [not null, default: 'cash']
  recipient_name varchar(255)
  recipient_phone varchar(255)
  shipping_address varchar(255)
  shipping_city varchar(255)
  payment_status varchar(255) [not null, default: 'unpaid']

  checks {
    `payment_method in ('cash','bank_transfer','card')` [name: 'orders_payment_method_check']
    `status in ('pending','confirmed','preparing','shipping','delivered','completed','cancelled','delivery_failed','returned','refunded')` [name: 'orders_status_check']
    `payment_status in ('unpaid','paid')` [name: 'orders_payment_status_check']
  }
}

Table order_lines {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  variant_id varchar(255) [not null]
  quantity int [not null, default: 1]
  unit_price decimal(12,2) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  checks {
    `quantity > 0` [name: 'order_lines_quantity_check']
    `unit_price >= 0` [name: 'order_lines_unit_price_check']
  }
}

Table order_transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  variant_id varchar(255) [not null]
  quantity int [not null, default: 1]
  unit_price decimal(12,2) [not null]
  subtotal decimal(12,2) [not null, default: 0]
  employee_id varchar(255) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  checks {
    `quantity > 0` [name: 'order_transactions_quantity_check']
    `subtotal >= 0` [name: 'order_transactions_subtotal_check']
    `unit_price >= 0` [name: 'order_transactions_unit_price_check']
  }
}

// ============================================================================
// XII. HOA DON - DB: cosmetic_invoice_service
// ============================================================================

Table invoices {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(255) [not null, unique]
  order_id varchar(255) [not null, unique]
  customer_id varchar(255) [not null]
  total_amount decimal(12,2) [not null, default: 0]
  paid_amount decimal(12,2) [not null, default: 0]
  status text [not null, default: 'UNPAID']
  note varchar(255)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  checks {
    `total_amount >= 0` [name: 'invoices_total_amount_check']
    `paid_amount >= 0` [name: 'invoices_paid_amount_check']
    `status in ('UNPAID','PARTIAL','PAID')` [name: 'invoices_status_check']
  }
}

// ============================================================================
// XIII. THU CHI - DB: cosmetic_receipt_service
// ============================================================================

Table receipts {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(255) [not null, unique]
  amount decimal(12,2) [not null, default: 0]
  source text [not null, default: 'MANUAL']
  invoice_id varchar(255)
  customer_id varchar(255)
  note varchar(255)
  employee_id varchar(255)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  checks {
    `amount >= 0` [name: 'receipts_amount_check']
    `source in ('MANUAL','AUTO_INVOICE_PAYMENT')` [name: 'receipts_source_check']
  }
}

Table payments {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(255) [not null, unique]
  amount decimal(12,2) [not null, default: 0]
  category text [not null, default: 'OTHER']
  source text [not null, default: 'MANUAL']
  purchase_order_id varchar(255)
  supplier_id varchar(255)
  note varchar(255)
  employee_id varchar(255)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  checks {
    `amount >= 0` [name: 'payments_amount_check']
    `category in ('SUPPLIER','SALARY','INFRASTRUCTURE','MATERIAL','OTHER')` [name: 'payments_category_check']
    `source in ('MANUAL','AUTO_PURCHASE')` [name: 'payments_source_check']
  }
}

// ============================================================================
// XIV. PHAN QUYEN (RBAC) - DB: cosmetic_authorization_service
// ============================================================================

Table roles {
  id varchar(255) [pk]
  name varchar(255) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table permissions {
  id varchar(255) [pk]
  resource text [not null]
  action text [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table roles_permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  role_id varchar(255) [not null]
  permission_id varchar(255) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (role_id, permission_id) [unique, name: 'roles_permissions_role_id_permission_id_unique']
  }
}

// ============================================================================
// XV. EMAIL GUI DON HANG - DB: cosmetic_notification_service
// ============================================================================

Table email_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id varchar(255) [not null, note: 'FK logic -> orders.id']
  event_type varchar(255) [not null, note: 'su kien gui email: order.placed, order.shipped, ...']
  recipient varchar(255) [not null]
  subject varchar(255) [not null]
  status text [not null]
  provider_id varchar(255) [note: 'id tren Resend/SMTP']
  error text
  created_at timestamptz [not null]

  checks {
    `status in ('sent','failed','skipped')` [name: 'email_logs_status_check']
  }

  Indexes {
    (order_id, event_type) [unique, name: 'email_logs_order_event_unique']
  }
}

// ============================================================================
// XVI. NHAT KY THAO TAC - DB: cosmetic_audit_service
// ============================================================================

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  actor_id varchar(255) [note: 'FK logic -> users.id (nguoi thuc hien)']
  actor_name varchar(255)
  action text [not null]
  entity_type varchar(255) [not null, note: 'loai doi tuong bi anh huong: Order, Invoice, ...']
  entity_id varchar(255)
  before_data jsonb [note: 'du lieu truoc khi thay doi']
  after_data jsonb [note: 'du lieu sau khi thay doi']
  metadata jsonb
  ip_address varchar(255)
  user_agent varchar(255)
  created_at timestamptz [not null]

  checks {
    `action in ('CREATE','UPDATE','DELETE','LOGIN','LOGOUT','VIEW','EXPORT','ACTIVATE','DEACTIVATE','OTHER')` [name: 'audit_logs_action_check']
  }
}

// ============================================================================
// XVII. GIO HANG - DB: cosmetic_basket_service
// ============================================================================

Table carts {
  id uuid [pk, default: `gen_random_uuid()`]
  customer_id varchar(255) [not null, unique, note: 'FK logic -> customers.id (1 khach 1 gio)']
  status varchar(255) [not null, default: 'OPEN']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  checks {
    `status in ('OPEN','CHECKED_OUT')` [name: 'carts_status_check']
  }
}

Table cart_items {
  id uuid [pk, default: `gen_random_uuid()`]
  cart_id uuid [not null]
  variant_id varchar(255) [not null, note: 'FK logic -> cosmetic_variants.id']
  quantity int [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  checks {
    `quantity > 0` [name: 'cart_items_quantity_check']
  }

  Indexes {
    (cart_id, variant_id) [unique, name: 'cart_items_cart_id_variant_id_unique']
  }
}


// ============================================================================
// FK VAT LY - co FK constraint that + ON DELETE CASCADE trong Postgres
// ============================================================================

Ref: addresses.customer_id > customers.id [delete: cascade]
Ref: phones.customer_id > customers.id [delete: cascade]
Ref: cosmetic_categories.cosmetic_id > cosmetics.id [delete: cascade]
Ref: cosmetic_variants.cosmetic_id > cosmetics.id [delete: cascade]
Ref: roles_permissions.role_id > roles.id [delete: cascade]
Ref: roles_permissions.permission_id > permissions.id [delete: cascade]
Ref: batches.inventory_id > inventories.id [delete: cascade]
Ref: stock_adjustments.batch_id > batches.id [delete: cascade]
Ref: cart_items.cart_id > carts.id [delete: cascade]
Ref: purchase_order_lines.purchase_order_id > purchase_orders.id [delete: cascade]
Ref: purchase_transactions.purchase_order_id > purchase_orders.id [delete: cascade]
Ref: order_lines.order_id > orders.id [delete: cascade]
Ref: order_transactions.order_id > orders.id [delete: cascade]

// ============================================================================
// FK LOGIC - khac service/database, KHONG co constraint (dieu khien boi app)
// ============================================================================

// --- Identity / Organization / Phan quyen ---
Ref: users.role_id > roles.id
Ref: users.id - auth_users.user_id
Ref: users.id - employees.user_id
Ref: users.id - customers.user_id
Ref: employees.department_id > departments.id
Ref: departments.manager_id > employees.id

// --- Danh muc / San pham / Ton kho ---
Ref: cosmetic_categories.category_id > categories.id
Ref: cosmetic_variants.id - inventories.variant_id
Ref: batches.supplier_id > suppliers.id
Ref: stock_adjustments.variant_id > cosmetic_variants.id
Ref: inventories.created_by > users.id
Ref: batches.created_by > users.id
Ref: stock_adjustments.created_by > users.id

// --- Nhap hang ---
Ref: purchase_orders.supplier_id > suppliers.id
Ref: purchase_orders.employee_id > employees.id
Ref: purchase_order_lines.variant_id > cosmetic_variants.id
Ref: purchase_transactions.variant_id > cosmetic_variants.id
Ref: purchase_transactions.employee_id > employees.id

// --- Ban hang ---
Ref: orders.customer_id > customers.id
Ref: order_lines.variant_id > cosmetic_variants.id
Ref: order_transactions.variant_id > cosmetic_variants.id
Ref: order_transactions.employee_id > employees.id

// --- Hoa don / Thu chi ---
Ref: orders.id - invoices.order_id
Ref: invoices.customer_id > customers.id
Ref: receipts.invoice_id > invoices.id
Ref: receipts.customer_id > customers.id
Ref: receipts.employee_id > employees.id
Ref: payments.purchase_order_id > purchase_orders.id
Ref: payments.supplier_id > suppliers.id
Ref: payments.employee_id > employees.id

// --- Gio hang ---
Ref: carts.customer_id > customers.id
Ref: cart_items.variant_id > cosmetic_variants.id

// --- Email thong bao / Nhat ky he thong ---
Ref: email_logs.order_id > orders.id
Ref: audit_logs.actor_id > users.id
