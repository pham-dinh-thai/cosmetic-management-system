{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transformIgnorePatterns": ["node_modules/(?!(@mikro-orm|kysely)/)"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "module": "commonjs",
          "moduleResolution": "bundler",
          "resolvePackageJsonExports": false,
          "allowJs": true
        }
      }
    ]
  }
}
