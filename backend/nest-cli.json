{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/gateway-service/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true
  },
  "monorepo": true,
  "defaultProject": "gateway-service",
  "projects": {
    "authentication-service": {
      "type": "application",
      "root": "apps/authentication-service",
      "entryFile": "main",
      "sourceRoot": "apps/authentication-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/authentication-service/tsconfig.app.json"
      }
    },
    "authorization-service": {
      "type": "application",
      "root": "apps/authorization-service",
      "entryFile": "main",
      "sourceRoot": "apps/authorization-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/authorization-service/tsconfig.app.json"
      }
    },
    "department-service": {
      "type": "application",
      "root": "apps/department-service",
      "entryFile": "main",
      "sourceRoot": "apps/department-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/department-service/tsconfig.app.json"
      }
    },
    "employee-service": {
      "type": "application",
      "root": "apps/employee-service",
      "entryFile": "main",
      "sourceRoot": "apps/employee-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/employee-service/tsconfig.app.json"
      }
    },
    "gateway-service": {
      "type": "application",
      "root": "apps/gateway-service",
      "entryFile": "main",
      "sourceRoot": "apps/gateway-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway-service/tsconfig.app.json"
      }
    },
    "security": {
      "type": "library",
      "root": "libs/security",
      "entryFile": "index",
      "sourceRoot": "libs/security/src",
      "compilerOptions": {
        "tsConfigPath": "libs/security/tsconfig.lib.json"
      }
    },
    "user-service": {
      "type": "application",
      "root": "apps/user-service",
      "entryFile": "main",
      "sourceRoot": "apps/user-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user-service/tsconfig.app.json"
      }
    }
  }
}